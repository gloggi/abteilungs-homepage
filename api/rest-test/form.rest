# Define Variables
@token = 
@host = http://localhost:8000

### GET request to retrieve all groups
GET {{host}}/api/forms
Accept: application/json
Authorization: Bearer {{token}}

### POST request to create a new group
POST {{host}}/api/forms
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
    "name": "Contact Us",
    "fields": [
        {
            "type": "textField",
            "label": "Name",
            "input_type": "text"
        },
        {
            "type": "textField",
            "label": "Email",
            "input_type": "email"
        },
        {
            "type": "textareaField",
            "label": "Message"
        },
        {
            "type": "selectField",
            "label": "Reason for Inquiry",
            "options": [
              {"name": "Test 1"},
              {"name": "Test 2"},
              {"name": "Test 3"}
            ]
        }
    ]
}

